{
  "id": "experiential",
  "providerId": "experiential",
  "label": "Experiential Labs",
  "shortLabel": "EXP",
  "order": 7,
  "setupGate": ["apiKey", "baseUrl"],
  "pickerGate": "catalog",
  "routing": {
    "staticCatalog": false,
    "discoveredCatalog": false,
    "checkedLast": true,
    "modelScheme": null
  },
  "groupLabelKey": "composer.modelExperientialGroup",
  "precedence": 7,
  "defaultModel": "qwen3.8-27b",
  "knownCatalog": false,
  "models": ["qwen3.8-27b", "fable-5"],
  "goModels": [],
  "speechModels": [],
  "vision": {},
  "modelFilter": null,
  "reasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.experientiallabs.ai/v1",
    "tiers": {}
  },
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["EXPERIENTIAL_API_KEY", "EXPLABS_API_KEY"],
      "configKey": "experientialApiKey",
      "label": "Experiential Labs API key",
      "signupUrl": "https://platform.experientiallabs.ai/settings/api-keys"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["EXPERIENTIAL_BASE_URL"],
      "configKey": "experientialBaseUrl",
      "label": "Experiential Labs base URL",
      "hint": "OpenAI-compatible endpoint override for all gateway models. Defaults to https://api.experientiallabs.ai/v1."
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": false
  },
  "billing": {
    "kind": "usd",
    "schedule": null,
    "balance": {
      "url": "https://api.experientiallabs.ai/api/v1/credits",
      "shape": "credits-usage"
    }
  },
  "cost": { "tier": "standard" },
  "usage": {
    "probe": "experiential-spend",
    "urls": [
      "/api/whoami",
      "/api/gateway/usage/events?org_id={org_id}&limit=1000",
      "/api/gateway/keys/{api_key_id}/limits",
      "/api/gateway/usage/daily?org_id={org_id}&scope=org&group_by=day"
    ],
    "primaryWindow": "day"
  },
  "strings": {
    "notConfigured": "Not configured yet — add an Experiential Labs gateway key in Settings → Models to use gateway models.",
    "apiBare": "Experiential · {baseUrl}",
    "quotaLabel": "Experiential spend",
    "quotaTitle": "Experiential {plan} · {left}% of today's spend cap left (resets in {resets}) · click to refresh",
    "quotaDailyTitle": "Today's spend {left}% below the daily cap (resets in {resets})",
    "creditTitle": "Credit balance ${credit}",
    "quotaNoData": "Experiential spend · no data: add an API key in Settings → Models, or this key has no usage yet · click to retry"
  },
  "errors": {
    "i18nPrefix": "experiential",
    "brands": ["Experiential"],
    "hosts": ["experientiallabs.ai"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": null,
    "allowMissingKey": false
  }
}
