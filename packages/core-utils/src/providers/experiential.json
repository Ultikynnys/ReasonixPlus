{
  "id": "experiential",
  "providerId": "experiential",
  "label": "Experiential Labs",
  "order": 7,
  "setupGate": ["apiKey", "baseUrl"],
  "pickerGate": "catalog",
  "routing": {
    "staticCatalog": false,
    "discoveredCatalog": false,
    "checkedLast": true,
    "modelScheme": null
  },
  "groupLabelKey": "composer.modelExperientialGroup",
  "precedence": 7,
  "defaultModel": "qwen3.8-27b",
  "knownCatalog": false,
  "models": ["qwen3.8-27b", "fable-5"],
  "goModels": [],
  "speechModels": [],
  "vision": {},
  "modelFilter": null,
  "reasoningEfforts": [],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.experientiallabs.ai/v1",
    "tiers": {}
  },
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["EXPERIENTIAL_API_KEY", "EXPLABS_API_KEY"],
      "configKey": "experientialApiKey",
      "label": "Experiential Labs API key",
      "signupUrl": "https://platform.experientiallabs.ai/settings/keys"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["EXPERIENTIAL_BASE_URL"],
      "configKey": "experientialBaseUrl",
      "label": "Experiential Labs base URL",
      "hint": "OpenAI-compatible endpoint override for all gateway models. Defaults to https://api.experientiallabs.ai/v1."
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": false
  },
  "billing": { "kind": "usd" },
  "strings": {
    "notConfigured": "Not configured yet — add an Experiential Labs gateway key in Settings → Models to use gateway models.",
    "apiBare": "Experiential · {baseUrl}"
  },
  "errors": {
    "i18nPrefix": "experiential",
    "brands": ["Experiential"],
    "hosts": ["experientiallabs.ai"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": null,
    "allowMissingKey": false
  }
}
