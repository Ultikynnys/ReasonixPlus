{
  "id": "ollama",
  "providerId": "ollama",
  "label": "Ollama",
  "shortLabel": "OLL",
  "order": 9,
  "setupGate": ["apiKey", "baseUrl"],
  "picker": false,
  "routing": {
    "staticCatalog": false,
    "discoveredCatalog": false,
    "checkedLast": false,
    "modelScheme": "ollama/"
  },
  "groupLabelKey": "settings.ollamaSection",
  "precedence": null,
  "defaultModel": null,
  "knownCatalog": false,
  "models": [],
  "goModels": [],
  "speechModels": [],
  "vision": { "fromProvider": "deepseek", "stripSchemeAndTag": true },
  "modelFilter": null,
  "reasoningEfforts": [],
  "reasoningRules": [
    { "pattern": "^gpt-oss(?:$|[-:])", "efforts": ["low", "medium", "high"] },
    { "pattern": "^deepseek-(?:v[4-9]|flash)", "efforts": ["low", "high", "max"], "aliases": { "medium": "high", "xhigh": "high" } }
  ],
  "endpoint": {
    "strategy": "standard",
    "default": "https://ollama.com/v1",
    "tiers": {},
    "keyTuple": "resolve"
  },
  "settingsPanel": "ollama-generation",
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["OLLAMA_API_KEY", "ollamaApiKey"],
      "configKey": "ollamaApiKey",
      "label": "Ollama API key",
      "signupUrl": "https://ollama.com/settings/keys"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["OLLAMA_BASE_URL"],
      "configKey": "ollamaBaseUrl",
      "label": "Ollama base URL"
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": true, "always": false },
  "discovery": {
    "strategy": "runtime",
    "listField": null,
    "idField": "id",
    "excludeSpeech": false
  },
  "wire": { "format": "ollama-native", "reasoningEffort": false },
  "billing": {
    "kind": "quota-if-key",
    "schedule": {
      "peakWindowsUtc": [{ "startMinute": 720, "endMinute": 1080 }],
      "weekendOffsetMinutes": 0
    },
    "peakModels": ["deepseek-v4.1-flash", "deepseek-v4-pro"],
    "prices": {
      "offPeakFactor": 0.5,
      "multipliers": { "input": 10, "cachedInput": 200, "output": 1 },
      "divisor": 5,
      "models": {
        "clef": { "input": 0.24 },
        "deepseek-v4.1-flash": { "input": 0.3, "cachedInput": 0.006, "output": 1.2 },
        "deepseek-v4-pro": { "input": 1.32, "cachedInput": 0.044, "output": 3.96 },
        "gemma4": { "input": 0.14, "cachedInput": 0.05, "output": 0.4 },
        "glm-5.2": { "input": 1.4, "cachedInput": 0.26, "output": 4.4 },
        "glm-5.3": { "input": 1.4, "cachedInput": 0.26, "output": 4.4 },
        "glm-5.3-flash": { "input": 0.15, "cachedInput": 0.03, "output": 0.5 },
        "gpt-oss:120b": { "input": 0.15, "cachedInput": 0.014, "output": 0.6 },
        "gpt-oss:20b": { "input": 0.07, "cachedInput": 0.035, "output": 0.3 },
        "kimi-k2.6": { "input": 0.95, "cachedInput": 0.16, "output": 4 },
        "kimi-k2.7-code": { "input": 0.95, "cachedInput": 0.19, "output": 4 },
        "kimi-k3": { "input": 3, "cachedInput": 0.3, "output": 15 },
        "minimax-m2.7": { "input": 0.3, "cachedInput": 0.06, "output": 1.2 },
        "minimax-m3": { "input": 0.6, "cachedInput": 0.12, "output": 2.4 },
        "minimax-m3.1-flash": { "input": 0.15, "cachedInput": 0.015, "output": 0.6 },
        "mistral-large-4": { "input": 0.68, "cachedInput": 0.07, "output": 2.09 },
        "mistral-large-3": { "input": 0.5, "output": 1.5 },
        "muse-spark-open": { "input": 1.25, "cachedInput": 0.15, "output": 4.25 },
        "nemotron-3-nano": { "input": 0.06, "output": 0.24 },
        "nemotron-3-super": { "input": 0.015, "cachedInput": 0.015, "output": 0.6 },
        "nemotron-3-ultra": { "input": 0.1, "cachedInput": 0.1, "output": 3 }
      }
    }
  },
  "cost": { "tier": "cheap" },
  "usage": {
    "probe": "ollama-balance",
    "urls": ["/api/balance"],
    "primaryWindow": "wk"
  },
  "strings": {
    "notConfigured": "Not configured yet — set an Ollama base URL / key and pick an Ollama model (Settings → Models).",
    "noCredential": "No Ollama endpoint configured for {model} — set a base URL / key (Settings → Models → Ollama).",
    "apiBare": "Ollama · {baseUrl}",
    "quotaLabel": "plan usage",
    "quotaTitle": "Weekly plan usage {left}% left (resets in {weeklyResets}) · session {session}% left (resets in {sessionResets}) · click to refresh",
    "quotaNoData": "Ollama usage · no data: set an API key in Settings → Models to see plan usage · click to retry",
    "quotaNoDataUnavailable": "Ollama usage · no data: an API key is set · click to retry",
    "creditTitle": "Purchased credit: ${credit}",
    "quotaPlanFallback": "free",
    "offPeakTitle": "Ollama Cloud off-peak: half of peak rates · Peak hours 12:00–18:00 UTC (weekdays), off-peak all day on weekends · changes in {when}",
    "peakTitle": "Ollama Cloud peak: double the off-peak rate · Peak hours 12:00–18:00 UTC (weekdays), off-peak all day on weekends · changes in {when}",
    "costTitle": "{model}: {multiplier}x, charging input, cached input and output by the declared multipliers and divisor",
    "modelsError": "Couldn't fetch Ollama models: {error}"
  },
  "errors": {
    "i18nPrefix": "ollama",
    "brands": ["Ollama"],
    "hosts": ["ollama.com", "localhost", "127.0.0.1"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": null,
    "allowMissingKey": true
  }
}
