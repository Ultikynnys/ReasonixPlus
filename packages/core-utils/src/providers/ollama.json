{
  "id": "ollama",
  "providerId": "ollama",
  "label": "Ollama",
  "order": 9,
  "setupGate": ["apiKey", "baseUrl"],
  "picker": false,
  "routing": {
    "staticCatalog": false,
    "discoveredCatalog": false,
    "checkedLast": false,
    "modelScheme": "ollama/"
  },
  "groupLabelKey": "settings.ollamaSection",
  "precedence": null,
  "defaultModel": null,
  "knownCatalog": false,
  "models": [],
  "goModels": [],
  "speechModels": [],
  "vision": { "fromProvider": "deepseek", "stripSchemeAndTag": true },
  "modelFilter": null,
  "reasoningEfforts": ["low", "medium", "high", "max"],
  "endpoint": {
    "strategy": "standard",
    "default": "https://ollama.com/v1",
    "tiers": {},
    "keyTuple": "resolve"
  },
  "settingsPanel": "ollama-generation",
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["OLLAMA_API_KEY", "ollamaApiKey"],
      "configKey": "ollamaApiKey",
      "label": "Ollama API key",
      "signupUrl": "https://ollama.com/settings/keys"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["OLLAMA_BASE_URL"],
      "configKey": "ollamaBaseUrl",
      "label": "Ollama base URL"
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": true, "always": false },
  "discovery": {
    "strategy": "runtime",
    "listField": null,
    "idField": "id",
    "excludeSpeech": false
  },
  "wire": { "format": "ollama-native", "reasoningEffort": false },
  "billing": {
    "kind": "quota-if-key",
    "schedule": {
      "peakWindowsUtc": [{ "startMinute": 720, "endMinute": 1080 }],
      "weekendOffsetMinutes": 0
    },
    "pricing": {
      "deepseek-v4-flash": { "inputCacheHit": 0.007, "inputCacheMiss": 0.22, "output": 0.66 },
      "deepseek-v4-pro": { "inputCacheHit": 0.022, "inputCacheMiss": 0.66, "output": 1.98 }
    }
  },
  "usage": { "probe": "ollama-balance" },
  "errors": {
    "i18nPrefix": "ollama",
    "brands": ["Ollama"],
    "hosts": ["ollama.com", "localhost", "127.0.0.1"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": null,
    "allowMissingKey": true
  }
}
