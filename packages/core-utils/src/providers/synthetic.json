{
  "id": "synthetic",
  "providerId": "synthetic",
  "label": "Synthetic",
  "order": 10,
  "setupGate": ["apiKey"],
  "groupLabelKey": "composer.modelSyntheticGroup",
  "precedence": 8,
  "defaultModel": "syn:large:text",
  "knownCatalog": true,
  "models": [
    "syn:large:text",
    "syn:small:text",
    "syn:large:vision",
    "syn:small:vision",
    "hf:Qwen/Qwen3.8-27B",
    "hf:deepseek-ai/DeepSeek-V4.1-Flash",
    "hf:deepseek-ai/DeepSeek-V4.1-Flash-1017",
    "hf:moonshotai/Kimi-K3",
    "hf:nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4",
    "hf:openai/gpt-oss-120b",
    "hf:zai-org/GLM-4.7-Flash",
    "hf:zai-org/GLM-5.3",
    "hf:zai-org/GLM-5.3-Flash"
  ],
  "goModels": [],
  "speechModels": [],
  "vision": {
    "models": [
      "syn:large:text",
      "hf:Qwen/Qwen3.8-27B",
      "hf:deepseek-ai/DeepSeek-V4.1-Flash",
      "hf:deepseek-ai/DeepSeek-V4.1-Flash-1017",
      "hf:moonshotai/Kimi-K3",
      "hf:zai-org/GLM-5.3-Flash"
    ],
    "patterns": ["^(?:syn|infinite):.*:vision$"]
  },
  "modelFilter": null,
  "reasoningEfforts": [],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.synthetic.new/openai/v1",
    "tiers": {}
  },
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["SYNTHETIC_API_KEY", "SYN_API_KEY"],
      "configKey": "syntheticApiKey",
      "label": "Synthetic API key",
      "signupUrl": "https://synthetic.new/billing/"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["SYNTHETIC_BASE_URL"],
      "configKey": "syntheticBaseUrl",
      "label": "Synthetic base URL",
      "hint": "OpenAI-compatible endpoint override for every Synthetic model. Defaults to https://api.synthetic.new/openai/v1."
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": false
  },
  "routing": {
    "staticCatalog": true,
    "discoveredCatalog": true,
    "checkedLast": false,
    "modelScheme": null
  },
  "billing": { "kind": "usd" },
  "errors": {
    "i18nPrefix": "synthetic",
    "brands": ["Synthetic"],
    "hosts": ["synthetic.new"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": null,
    "allowMissingKey": false
  }
}
