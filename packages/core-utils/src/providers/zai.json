{
  "id": "zai",
  "providerId": "zai",
  "label": "Z.AI",
  "shortLabel": "ZAI",
  "order": 3,
  "setupGate": ["apiKey"],
  "routing": {
    "staticCatalog": true,
    "discoveredCatalog": true,
    "checkedLast": false,
    "foreignCatalog": true,
    "modelScheme": null
  },
  "modelsDev": "zai",
  "groupLabelKey": "composer.modelZaiGroup",
  "precedence": 4,
  "defaultModel": "glm-5.3-flash",
  "knownCatalog": true,
  "models": [
    "glm-5.3-flash",
    "glm-5.3",
    "glm-5.2",
    "glm-5.1",
    "glm-5",
    "glm-4.7",
    "glm-4.7-flash",
    "glm-4.7-flashx",
    "glm-4.6",
    "glm-4.6v",
    "glm-4.6v-flash",
    "glm-4.6v-flashx",
    "glm-4.5",
    "glm-4.5-air",
    "glm-4.5-x",
    "glm-4.5-airx",
    "glm-4.5-flash",
    "glm-4.5v",
    "glm-4-32b-0414-128k"
  ],
  "goModels": [],
  "speechModels": [],
  "vision": {
    "models": ["glm-5.3-flash"],
    "patterns": ["^glm-\\d+(?:\\.\\d+)?v(?:-|$)"]
  },
  "modelFilter": null,
  "reasoningEfforts": [],
  "reasoningRules": [
    { "pattern": "^glm-5\\.3(?:$|[-:])", "efforts": ["low", "high", "max"], "forcedThinking": true, "aliases": { "medium": "high", "xhigh": "max" } },
    { "pattern": "^glm-5\\.2(?:$|[-:])", "efforts": ["high", "max"], "aliases": { "low": "high", "medium": "high", "xhigh": "max" } }
  ],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.z.ai/api/paas/v4",
    "tiers": {
      "coding": "https://api.z.ai/api/coding/paas/v4",
      "responses": "https://api.z.ai/api/v1"
    }
  },
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["ZAI_API_KEY"],
      "configKey": "zaiApiKey",
      "label": "Z.AI API key (also enables GLM models)",
      "signupUrl": "https://z.ai/manage-apikey/apikey-list"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["ZAI_BASE_URL"],
      "configKey": "zaiBaseUrl",
      "label": "Z.AI base URL",
      "hint": "OpenAI-compatible endpoint override for Z.AI. Empty uses the provider's default endpoint."
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": false
  },
  "wire": { "streamOptions": false, "toolStream": true, "thinking": "zai-top-level" },
  "billing": {
    "kind": "quota-if-key",
    "schedule": {
      "peakWindowsUtc": [{ "startMinute": 360, "endMinute": 600 }],
      "weekendOffsetMinutes": 480
    }
  },
  "usage": {
    "probe": "zai-monitor",
    "urls": ["/api/monitor/usage/quota/limit"],
    "primaryWindow": "5h",
    "resetsStyle": "absolute"
  },
  "strings": {
    "notConfigured": "Not configured yet — add a Z.AI API key in Settings → General to use GLM models.",
    "noCredential": "No Z.AI credential for {model} — add a Z.AI key in Settings → Models.",
    "quotaLabel": "GLM usage",
    "quotaTitle": "GLM Coding Plan {plan} · {left}% left · click to refresh",
    "quotaDualTitle": "GLM Coding Plan {plan} · 5h: {fiveHour}% left · weekly: {weekly}% left · resets {weeklyResets} · click to refresh",
    "quotaNoData": "GLM usage · no data: set a Z.AI API key (Settings → Z.AI / GLM) to see plan usage · click to retry",
    "quotaPlanName": "GLM Coding Plan",
    "quotaPlanFallback": "GLM",
    "offPeakTitle": "Z.AI off-peak: half of the standard rate · Peak hours 14:00–18:00 SGT (06:00–10:00 UTC, weekdays), off-peak all other times · changes in {when}",
    "peakTitle": "Z.AI peak: the standard rate (off-peak is 50% off) · Peak hours 14:00–18:00 SGT (06:00–10:00 UTC, weekdays) · changes in {when}"
  },
  "errors": {
    "i18nPrefix": "zai",
    "brands": ["Z.AI"],
    "hosts": ["z.ai"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": "zai-responses",
    "allowMissingKey": false
  }
}
