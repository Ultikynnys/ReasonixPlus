      "labelKey": "settings.mimoApiKey",
      "hintKey": "settings.mimoApiKeyHint"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["MIMO_BASE_URL"],
      "configKey": "mimoBaseUrl",
      "labelKey": "settings.mimoBaseUrl",
      "hintKey": "settings.mimoBaseUrlHint"
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
