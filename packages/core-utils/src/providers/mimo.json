{
  "id": "mimo",
  "providerId": "mimo",
  "label": "Xiaomi MiMo",
  "shortLabel": "MIMO",
  "order": 4,
  "setupGate": ["apiKey", "baseUrl"],
  "routing": {
    "staticCatalog": true,
    "discoveredCatalog": false,
    "checkedLast": false,
    "modelScheme": null
  },
  "groupLabelKey": "composer.modelMimoGroup",
  "precedence": 5,
  "defaultModel": "mimo-v2.6-pro",
  "knownCatalog": true,
  "models": [
    "mimo-v2.6-pro",
    "mimo-v2.6-flash",
    "mimo-v2.6-pro-ultraspeed",
    "mimo-v2.5-pro",
    "mimo-v2.5"
  ],
  "goModels": [],
  "speechModels": [
    "mimo-v2.5-asr",
    "mimo-v2.5-tts",
    "mimo-v2.5-tts-voiceclone",
    "mimo-v2.5-tts-voicedesign"
  ],
  "vision": {
    "models": ["mimo-v2.6-pro", "mimo-v2.6-flash", "mimo-v2.6-pro-ultraspeed"]
  },
  "modelFilter": null,
  "reasoningEfforts": [],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.xiaomimimo.com/v1",
    "tiers": {}
  },
  "settingsPanel": "mimo-auth",
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["MIMO_API_KEY"],
      "configKey": "mimoApiKey",
      "label": "MiMo API key",
      "hint": "Paste a Xiaomi MiMo API key. MiMo models bill through your subscription plan, not per token."
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["MIMO_BASE_URL"],
      "configKey": "mimoBaseUrl",
      "label": "MiMo base URL",
      "hint": "OpenAI-compatible endpoint override for all MiMo models. Defaults to https://api.xiaomimimo.com/v1."
    },
    {
      "key": "keyName",
      "kind": "internal",
      "env": [],
      "configKey": "mimoKeyName",
      "label": null
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": null
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": true
  },
  "wire": { "thinking": "mimo-top-level", "reasoningEffort": false },
  "billing": { "kind": "quota" },
  "usage": { "probe": "mimo-console" },
  "strings": {
    "notConfigured": "Not configured yet — add a Xiaomi MiMo API key in Settings → Models to use MiMo models.",
    "noCredential": "No Xiaomi MiMo credential for {model} — add a MiMo key in Settings → Models.",
    "quotaLabel": "MiMo plan",
    "quotaTitle": "Xiaomi MiMo subscription plan. MiMo bills through your plan; per-token usage isn't reported.",
    "quotaPlanFallback": "Token Plan",
    "panelSignInTitle": "Sign in with Xiaomi",
    "panelSignIn": "Sign in",
    "panelSignInHint": "Authorize Reasonix+ in your browser to provision a MiMo inference key automatically.",
    "panelWaiting": "Waiting for authorization in the browser…",
    "panelSignedIn": "Signed in to Xiaomi MiMo",
    "panelKeyStored": "A MiMo inference key is stored",
    "panelSignOut": "Sign out",
    "panelCancel": "Cancel",
    "panelFlowFailed": "MiMo sign-in failed"
  },
  "errors": {
    "i18nPrefix": "mimo",
    "brands": ["MiMo"],
    "hosts": ["xiaomimimo.com"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "api-key",
    "transport": "mimo-responses",
    "allowMissingKey": false
  }
}
