      "mimo-v2-pro-free",
      "kimi-k2.5-free",
      "x-preview-f-free"
    ]
  },
  "modelFilter": null,
  "reasoningEfforts": [],
  "reasoningRules": [
    { "pattern": "^deepseek-", "efforts": ["low", "high", "max"], "aliases": { "medium": "high", "xhigh": "high" } },
    { "pattern": "^glm-5\\.3", "efforts": ["low", "high", "max"], "forcedThinking": true },
    { "pattern": "^glm-5\\.2", "efforts": ["high", "max"], "aliases": { "low": "high", "medium": "high", "xhigh": "max" } },
    { "pattern": "^gpt-(?:6|5\\.6)", "efforts": ["low", "medium", "high", "xhigh", "max"] },
    { "pattern": "^gpt-5\\.[2345]", "efforts": ["low", "medium", "high", "xhigh"] },
    { "pattern": "^(?:gpt-5|gpt-oss|o[134])", "efforts": ["low", "medium", "high"] },
    { "pattern": "^mimo-", "efforts": [], "control": "none" }
  ],
  "endpoint": {
    "strategy": "tiered",
    "default": "https://opencode.ai/zen/v1",
    "tiers": { "go": "https://opencode.ai/zen/go/v1" }
  },
  "settingsPanel": "opencode-auth",
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["OPENCODE_API_KEY"],
      "configKey": "opencodeApiKey",
      "label": "OpenCode API key (OpenCode Zen)",
      "signupUrl": "https://opencode.ai/auth"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["OPENCODE_BASE_URL"],
      "configKey": "opencodeBaseUrl",
      "label": "OpenCode base URL",
      "hint": "OpenAI-compatible endpoint override for all OpenCode models. Defaults to Zen (https://opencode.ai/zen/v1); Go models use https://opencode.ai/zen/go/v1 unless overridden here."
    }
  ],
  "credentials": {
    "publicKey": "public",
    "oauthConfig": "opencodeOAuth"
  },
  "usable": { "apiKey": false, "keylessLocal": false, "always": true },
  "discovery": {
    "strategy": "models.dev",
    "listField": null,
    "idField": "id",
    "excludeSpeech": false
  },
  "billing": { "kind": "none", "schedule": null },
  "usage": {
    "probe": "opencode-usage",
    "urls": ["/zen/go/v1/usage"],
    "urlGate": "declared-hosts",
    "primaryWindow": "5h"
  },
  "strings": {
    "notConfigured": "Not configured yet — OpenCode endpoint is unavailable.",
    "noCredential": "No OpenCode configuration for {model}.",
    "apiBare": "OpenCode · {baseUrl}",
