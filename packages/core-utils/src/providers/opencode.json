  "errors": {
    "i18nPrefix": "opencode",
    "brands": ["OpenCode"],
    "hosts": ["opencode.ai"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "opencode",
    "transport": "opencode-muse-responses",
    "allowMissingKey": true
  }
