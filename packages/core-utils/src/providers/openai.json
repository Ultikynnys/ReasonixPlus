{
  "id": "openai",
  "providerId": "openai",
  "label": "OpenAI",
  "shortLabel": "OAI",
  "order": 2,
  "setupGate": ["apiKey", "oauth"],
  "routing": {
    "staticCatalog": true,
    "discoveredCatalog": true,
    "checkedLast": false,
    "foreignCatalog": true,
    "modelScheme": null
  },
  "modelsDev": "openai",
  "groupLabelKey": "composer.modelOpenAIGroup",
  "precedence": 3,
  "defaultModel": "gpt-6.1-sol",
  "knownCatalog": true,
  "models": [
    "gpt-6.1-sol",
    "gpt-6-astra",
    "gpt-6-sol",
    "gpt-6-luna",
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna"
  ],
  "goModels": [],
  "speechModels": [],
  "vision": { "patterns": ["^gpt-"] },
  "modelFilter": null,
  "reasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
  "reasoningRules": [
    { "pattern": "^(?:gpt-(?:4|3)|chatgpt-4)", "efforts": [], "control": "none" },
    { "pattern": "^o1-pro(?:$|-)", "efforts": [], "control": "none" },
    { "pattern": "^(?:o[134]|gpt-oss)(?:$|-)", "efforts": ["low", "medium", "high"] },
    { "pattern": "^gpt-5\\.[2345].*-pro(?:$|-)", "efforts": ["medium", "high", "xhigh"] },
    { "pattern": "^gpt-5\\.[2345](?:$|-)", "efforts": ["low", "medium", "high", "xhigh"] },
    { "pattern": "^gpt-5(?:$|\\.1(?:$|-)|-)", "efforts": ["low", "medium", "high"] }
  ],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.openai.com/v1",
    "tiers": {}
  },
  "settingsPanel": "openai-auth",
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["OPENAI_API_KEY"],
      "configKey": "openaiApiKey",
      "label": "OpenAI API key"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["OPENAI_BASE_URL"],
      "configKey": "baseUrl",
      "label": "OpenAI base URL",
      "hint": "OpenAI-compatible endpoint override for OpenAI. Empty uses the provider's default endpoint."
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": "openaiOAuth"
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": false
  },
  "wire": { "storeFlag": true },
  "billing": { "kind": "usd-unless-oauth", "schedule": null },
  "usage": {
    "probe": "codex-oauth",
    "urls": [
      "https://chatgpt.com/backend-api/wham/usage",
      "https://chatgpt.com/backend-api/codex/rate_limits"
    ],
    "primaryWindow": "wk",
    "resetsStyle": "absolute",
    "minIntervalSeconds": 300
  },
  "strings": {
    "notConfigured": "Not configured yet — add an OpenAI key or sign in with ChatGPT (Settings → OpenAI) first.",
    "noCredential": "No OpenAI credential for {model} — add an OpenAI key or sign in with ChatGPT (Settings → OpenAI).",
    "apiOauth": "OpenAI · {baseUrl} · signed in as {account}",
    "apiKey": "OpenAI · {baseUrl} · manual API key",
    "apiNone": "OpenAI · {baseUrl} · not signed in: sign in with OpenAI in Settings",
    "oauthFailed": "OpenAI sign-in failed: {message}. Re-sign in from Settings",
    "quotaLabel": "codex",
    "quotaTitle": "Codex weekly quota · {left}% left · resets {resets} · plan {plan} · click to refresh",
    "quotaDualTitle": "Codex quota · 5h {fiveHour}% left (resets {sessionResets}) · weekly {weekly}% left (resets {weeklyResets}) · plan {plan} · click to refresh",
    "quotaLimitedTitle": "Out of Codex messages · requests are refused until the spent window resets · 5h resets {sessionResets} · weekly {weekly}% left",
    "quotaFiveHourTitle": "5-hour window: {left}% left",
    "quotaNoData": "Codex quota · no data: sign in with ChatGPT (Settings → OpenAI) to see plan usage · click to retry",
    "quotaPlanName": "ChatGPT",
    "quotaPlanFallback": "ChatGPT",
    "panelSignInTitle": "Website sign-in",
    "panelSignIn": "Sign in with OpenAI",
    "panelSignInHint": "Log in with an OpenAI website account. The token is stored locally and refreshed automatically.",
    "panelWaiting": "Waiting for the browser sign-in…",
    "panelSignedIn": "Signed in with OpenAI",
    "panelAccount": "Signed in as {account}",
    "panelTokenSet": "OAuth token active",
    "panelSignOut": "Sign out",
    "panelCancel": "Cancel",
    "panelFlowFailed": "OpenAI sign-in failed: re-sign in from this panel"
  },
  "errors": {
    "i18nPrefix": "openai",
    "brands": ["OpenAI"],
    "hosts": ["openai.com", "chatgpt.com"],
    "serverReport": "standard"
  },
  "client": {
    "auth": "openai-oauth",
    "transport": "codex",
    "allowMissingKey": false
  }
}
