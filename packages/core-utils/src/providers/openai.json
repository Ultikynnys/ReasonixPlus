{
  "id": "openai",
  "providerId": "openai",
  "label": "OpenAI",
  "order": 2,
  "setupGate": ["apiKey", "oauth"],
  "routing": {
    "staticCatalog": true,
    "discoveredCatalog": true,
    "checkedLast": false,
    "foreignCatalog": true,
    "modelScheme": null
  },
  "modelsDev": "openai",
  "groupLabelKey": "composer.modelOpenAIGroup",
  "precedence": 3,
  "defaultModel": "gpt-6.1-sol",
  "knownCatalog": true,
  "models": [
    "gpt-6.1-sol",
    "gpt-6-astra",
    "gpt-6-sol",
    "gpt-6-luna",
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna"
  ],
  "goModels": [],
  "speechModels": [],
  "vision": { "patterns": ["^gpt-"] },
  "modelFilter": null,
  "reasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
  "endpoint": {
    "strategy": "standard",
    "default": "https://api.openai.com/v1",
    "tiers": {}
  },
  "settingsPanel": "openai-auth",
  "settings": [
    {
      "key": "apiKey",
      "kind": "secret",
      "env": ["OPENAI_API_KEY"],
      "configKey": "openaiApiKey",
      "labelKey": "settings.openaiApiKey"
    },
    {
      "key": "baseUrl",
      "kind": "url",
      "env": ["OPENAI_BASE_URL"],
      "configKey": "baseUrl",
      "labelKey": "settings.providerBaseUrl",
      "hintKey": "settings.providerBaseUrlHint"
    }
  ],
  "credentials": {
    "publicKey": null,
    "oauthConfig": "openaiOAuth"
  },
  "usable": { "apiKey": true, "keylessLocal": false, "always": false },
  "discovery": {
    "strategy": "models-endpoint",
    "listField": "data",
    "idField": "id",
    "excludeSpeech": false
  },
  "client": {
    "auth": "openai-oauth",
    "transport": "codex",
    "allowMissingKey": false
  }
}
